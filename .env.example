# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git에 올라가지 않는다.
#   cp .env.example .env

# ── 로컬 개발 (docker-compose.yml) ─────────────────────────────
MYSQL_ROOT_PASSWORD=applegame

# ── 프로덕션 (docker-compose.prod.yml, VM의 /opt/applegame/.env) ──
# 배포할 앱 이미지 태그 — deploy.sh가 커밋 SHA로 덮어쓴다
APP_TAG=latest

# Spring (application-prod.yaml 의 플레이스홀더로 주입)
DB_URL=jdbc:mysql://mysql:3306/applegame?serverTimezone=Asia/Seoul&characterEncoding=UTF-8&rewriteBatchedStatements=true
DB_USERNAME=root
DB_PASSWORD=change-me
# openssl rand -base64 64 로 생성 (HS512 서명에 충분한 길이)
JWT_SECRET=change-me

# Grafana 관리자 비밀번호 (첫 로그인: admin / 아래 값)
GRAFANA_ADMIN_PASSWORD=change-me
